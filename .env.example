SCREENSHOTONE_ACCESS_KEY=your_screenshotone_access_key
# Set to 1 only behind a reverse proxy that overwrites X-Real-IP.
SHOT_TRUST_PROXY=0

# Gallery SQLite database. Defaults to ./server/data/sites.db.
# In production use an absolute path outside the release folders, e.g.
# SITES_DB_PATH=/home/forge/mockduo.stemonte.io/data/sites.db
