{
  "name": "duo-preview",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "shots": "node --env-file-if-exists=.env server/screenshot-server.mjs",
    "build": "tsc -b && vite build",
    "postbuild": "node --env-file-if-exists=.env scripts/link-shot-cache.mjs",
    "test": "node --test server/*.test.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
